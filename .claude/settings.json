{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git fetch -q origin 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Fetching origin...",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-main-git.mjs",
            "if": "Bash(git commit *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-main-git.mjs",
            "if": "Bash(git push *)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
